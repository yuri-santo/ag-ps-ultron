# Cenário SERVIDOR: máquina Linux dedicada (futuro). Mesmo layout do PC para
# a migração ser "copiar /opt/agent-stacks + restaurar backup".
#   cp cenarios/servidor.env.example .env && chmod 600 .env

CENARIO=servidor
TZ=America/Sao_Paulo

STACKS_ROOT=/opt/agent-stacks
DATA_ROOT=/opt/agent-stacks/homelab-data
VENDOR_ROOT=/opt/agent-stacks/homelab/vendor
MEDIA_ROOT=/srv/midia

PUID=1000
PGID=1000

# IP da LAN do servidor (ou 0.0.0.0 atrás de firewall). Nunca abra porta no roteador:
# acesso externo só por Cloudflare Tunnel ou Tailscale.
BIND=192.168.0.50

# nvidia | rocm | none  (rocm: Ollama funciona; FramePack/ComfyUI desta pasta são só CUDA)
GPU=nvidia

HOMELAB_STACKS="ia arquivos midia monitor"
COMPOSE_PROFILES=ollama,gerar

# Obrigatório no servidor (BIND fora do loopback): openssl rand -hex 32
AI_MEMORY_AUTH_TOKEN=
AI_MEMORY_LLM_PROVIDER=openai-compat
AI_MEMORY_LLM_BASE_URL=http://ollama:11434/v1
AI_MEMORY_LLM_MODEL=qwen3:8b

# Backup restic (scripts/backup-restic.sh)
RESTIC_REPOSITORY=/mnt/nas/backup/homelab
RESTIC_PASSWORD_FILE=/root/.config/restic/senha
