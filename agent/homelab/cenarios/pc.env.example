# Cenário PC: este Windows (san-saitama) com Docker Engine dentro do WSL Debian,
# o mesmo WSL onde o Hermes/Ultron roda como root. Copie para ../.env e ajuste.
#   cp cenarios/pc.env.example .env && chmod 600 .env

CENARIO=pc
TZ=America/Sao_Paulo

# Onde ficam os stacks e os dados (mesma convenção do /opt/agent-stacks que você já usa).
STACKS_ROOT=/opt/agent-stacks
DATA_ROOT=/opt/agent-stacks/homelab-data
VENDOR_ROOT=/opt/agent-stacks/homelab/vendor
MEDIA_ROOT=/mnt/d/Midia

# Usuário dono dos dados (UID/GID no WSL). root do Hermes lê tudo de qualquer forma.
PUID=1000
PGID=1000

# No PC tudo escuta só em 127.0.0.1.
BIND=127.0.0.1

# GPU para os stacks de IA: nvidia | rocm | none
# No WSL com NVIDIA: driver Windows atualizado + nvidia-container-toolkit dentro do Debian.
GPU=none

# Stacks que "homelab.sh up all" sobe, na ordem.
HOMELAB_STACKS="ia arquivos"

# Perfis opcionais de compose:
#   ollama  -> Ollama local (FrankSherlock/FrankYomik e LLM local via API)
#   gerar   -> FramePack (vídeo) e ComfyUI em container (no PC prefira o ComfyUI-Easy-Install nativo)
# Vazio no notebook: o WSL tem teto de 8 GB e o LM Studio do Windows já cobre LLM local.
COMPOSE_PROFILES=

# --- ia ---
# Obrigatório se BIND não for 127.0.0.1. Gere com: openssl rand -hex 32
AI_MEMORY_AUTH_TOKEN=
# Vazio = ai-memory em modo zero-LLM (captura, busca e handoff funcionam sem API).
# Provedor local opcional (OpenAI-compatível):
#   Ollama do próprio stack:  AI_MEMORY_LLM_BASE_URL=http://ollama:11434/v1  + AI_MEMORY_LLM_MODEL=qwen3:8b
#   LM Studio do Windows (1234): depende da rede do WSL; teste antes com
#     docker run --rm --add-host host.docker.internal:host-gateway curlimages/curl -s http://host.docker.internal:1234/v1/models
#   Se não responder, fique no Ollama ou no modo zero-LLM.
AI_MEMORY_LLM_PROVIDER=
AI_MEMORY_LLM_BASE_URL=
AI_MEMORY_LLM_MODEL=

